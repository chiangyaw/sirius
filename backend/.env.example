# Sirius environment variables — copy to .env and fill in.
# Secrets live ONLY here (git-ignored). Non-secret settings live in config.yaml.

# ── LLM: Claude on GCP Vertex AI ──────────────────────────────────────────────
# Sirius calls Claude via Vertex using the anthropic[vertex] SDK.
# Project + region can be set here or in config.yaml (llm.vertex_project / region).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
CLOUD_ML_REGION=us-east5
# Application Default Credentials: run `gcloud auth application-default login`,
# OR point at a service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# ── Prisma AIRS (AI Runtime Security) ────────────────────────────────────────
# x-pan-token for the AIRS scan API. Endpoint + profile name live in config.yaml.
PANW_AI_SEC_API_KEY=your-prisma-airs-api-token

# ── Cortex XDR ────────────────────────────────────────────────────────────────
# Advanced or Standard API auth (Sirius auto-detects). Get these from the console:
#   Settings → Configurations → API Keys.
CORTEX_API_KEY=your-cortex-api-key
CORTEX_API_KEY_ID=your-cortex-api-key-id
# Tenant API URL (REQUIRED for live calls). Console: API Keys → "Copy URL".
#   https://api-yourtenant.xdr.us.paloaltonetworks.com
CORTEX_FQDN=
# Kubernetes agent distribution id (optional; for generate/deploy k8s agent).
CORTEX_DISTRIBUTION_ID=

# ── AWS (TEMPORARY credentials with session token supported) ─────────────────
# Sirius honors session tokens for Terraform / purple-team / EKS work.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
# Or use a configured / SSO profile instead of the three keys above:
# AWS_PROFILE=your-profile

# ── Optional overrides ────────────────────────────────────────────────────────
# SIRIUS_CONFIG_PATH=/absolute/path/to/config.yaml
